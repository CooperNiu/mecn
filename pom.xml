<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mecn</groupId>
  <artifactId>mecn</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>mecn</name>
  <description>Macro Economic Causal Network - High-Dimensional Macroeconomic Causal Network Analysis Platform</description>

  <!-- Spring Boot Parent -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.0.13</version>
    <relativePath/>
  </parent>

  <modules>
    <module>mecn-core</module>
    <module>mecn-datahub</module>
    <module>mecn-ai</module>
    <module>mecn-app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.9.3</junit.version>
    <mockito.version>5.3.1</mockito.version>
    <smile.version>3.0.2</smile.version>
    <jgrapht.version>1.5.2</jgrapht.version>
    <itext.version>7.2.5</itext.version>
    <redis.version>3.0.13</redis.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Internal Modules -->
      <dependency>
        <groupId>com.mecn</groupId>
        <artifactId>mecn-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mecn</groupId>
        <artifactId>mecn-datahub</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mecn</groupId>
        <artifactId>mecn-ai</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Smile: LASSO Regression -->
      <dependency>
        <groupId>com.github.haifengl</groupId>
        <artifactId>smile-core</artifactId>
        <version>${smile.version}</version>
      </dependency>

      <!-- JGraphT: Graph Data Structure -->
      <dependency>
        <groupId>org.jgrapht</groupId>
        <artifactId>jgrapht-core</artifactId>
        <version>${jgrapht.version}</version>
      </dependency>

      <!-- iText PDF: PDF Generation -->
      <dependency>
        <groupId>com.itextpdf</groupId>
        <artifactId>itext7-core</artifactId>
        <version>${itext.version}</version>
        <type>pom</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.10</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
